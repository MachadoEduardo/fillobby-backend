{
  "name": "fillobby",
  "version": "1.0.0",
  "description": "API REST para grupos de amigos organizarem, votarem e acompanharem uma fila compartilhada de jogos.",
  "type": "module",
  "main": "app.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs}\"",
    "lint:openapi": "redocly lint docs/openapi.yaml",
    "test": "vitest run --no-file-parallelism",
    "test:ci": "node -e \"if (!process.env.TEST_MONGO_URI) throw new Error('TEST_MONGO_URI is required')\" && vitest run --no-file-parallelism",
    "test:watch": "vitest --no-file-parallelism"
  },
  "keywords": [],
  "author": "Eduardo Machado",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.53.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  }
}
